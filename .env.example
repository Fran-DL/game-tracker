# Credenciales de la app de Twitch, usadas por el proxy de desarrollo de Vite
# (vite-plugins/igdbDevProxy.ts) para autenticar las peticiones a IGDB.
#
# IMPORTANTE: estas variables NO llevan el prefijo VITE_ a propósito. Vite
# solo expone al navegador las variables que empiezan con VITE_; al dejarlas
# sin ese prefijo, el client_secret nunca se incluye en el bundle del cliente
# y solo vive en el proceso Node del servidor de desarrollo.
#
# 1. Crea una app en https://dev.twitch.tv/console/apps
# 2. Copia este archivo a ".env" en la raíz del proyecto:
#      cp .env.example .env
# 3. Completa los valores con tu Client ID y Client Secret.
# 4. Reiniciá "npm run dev" tras modificar .env.
TWITCH_CLIENT_ID=tu_client_id_aqui
TWITCH_CLIENT_SECRET=tu_client_secret_aqui